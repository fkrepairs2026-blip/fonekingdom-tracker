rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'jay111786@gmail.com' ||
        (exists(/databases/$(database)/documents/shoplog_users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/shoplog_users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isLoggedIn() {
      return request.auth != null;
    }

    // ─── USER PROFILES ────────────────────────────────────────────────────
    match /shoplog_users/{uid} {
      allow read:   if isLoggedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isLoggedIn() && request.auth.uid == uid;
      allow update: if isLoggedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ─── REPAIRS ─────────────────────────────────────────────────────────
    match /repairs/{repairId} {
      allow read: if isLoggedIn() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );
      allow create: if isLoggedIn() &&
        request.resource.data.createdBy == request.auth.uid;
      allow update: if isLoggedIn() && (
        isAdmin() ||
        (resource.data.createdBy == request.auth.uid &&
         resource.data.submitted == false)
      );
      allow delete: if isAdmin();
    }

    // ─── DELETED REPAIRS (archive) ───────────────────────────────────────
    match /deleted_repairs/{docId} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;  // immutable — no editing delete history
    }

    // ─── ATTENDANCE ───────────────────────────────────────────────────────
    // Doc ID format: {uid}_{YYYY-MM-DD}
    // Use the doc ID to determine ownership — avoids null resource bug
    // when reading a doc that doesn't exist yet.
    match /shoplog_attendance/{attId} {
      allow read:   if isLoggedIn() && (isAdmin() || attId.matches(request.auth.uid + '_.*'));
      allow create: if isLoggedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isLoggedIn() && (isAdmin() || resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

  }
}
